# LiteLLM provider/model identifier. Groq is the first configured provider.
AGENT_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
# For an OpenAI-compatible server, set AGENT_MODEL=openai/your-model
# and set AGENT_API_BASE plus AGENT_API_KEY_ENV to your key variable name.
AGENT_API_BASE=
AGENT_API_KEY_ENV=
AGENT_VISION=false
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS=1024
AGENT_MAX_INPUT_TOKENS=6000
ADB_PATH=adb
ANDROID_SERIAL=
